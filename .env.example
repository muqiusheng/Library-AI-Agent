# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_FRONTEND_ORIGINS=["http://localhost:4173","http://127.0.0.1:4173","http://localhost:5173"]

# PostgreSQL
DATABASE_URL=postgresql+psycopg://bookpath:bookpath@localhost:5432/bookpath
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_PREFIX=bookpath
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
IMPORT_UPLOAD_DIRECTORY=./data/uploads
IMPORT_MAX_BYTES=67108864

# Authentication (replace in every deployed environment)
JWT_SECRET=change-me-before-deployment-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=120

# DeepSeek official OpenAI-compatible API
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro

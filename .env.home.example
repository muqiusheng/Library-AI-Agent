# Copy with scripts/home/init-home-env.ps1; never commit the generated .env.home file.
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_FRONTEND_ORIGINS=["http://127.0.0.1:8180"]

POSTGRES_DB=bookpath
POSTGRES_USER=bookpath
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
DATABASE_URL=postgresql+psycopg://bookpath:__POSTGRES_PASSWORD__@postgres:5432/bookpath
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

CHROMA_PERSIST_DIRECTORY=/app/data/chroma
CHROMA_COLLECTION_PREFIX=bookpath
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
IMPORT_UPLOAD_DIRECTORY=/app/data/uploads
IMPORT_MAX_BYTES=67108864

JWT_SECRET=__JWT_SECRET__
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=120

# Keep closed for initial production validation. To invite users, set true and
# use a generated value of at least 8 characters for REGISTRATION_INVITE_CODE.
REGISTRATION_ENABLED=false
REGISTRATION_INVITE_CODE=
MAX_ACCOUNT_COUNT=50

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=6
RATE_LIMIT_BATCH_TAG_PER_MINUTE=2

# Optional external model provider. Leave the key empty for degraded/no-model mode.
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
